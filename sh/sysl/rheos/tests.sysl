module sh.sysl.rheos
@tests

private val zero = Vec3(0.0, 0.0, 0.0)
private val room = Enclosure(Vec3(5.0, 5.0, 5.0), 1.0)
private near(a: real, b: real) = assert((a - b).abs() < 1e-9, s"expected ${b}, got ${a}")

@test("free flight and body-frame quaternion integration")
flight()
    var bodies = [sphere(zero, Vec3(1.0, 2.0, -3.0), angular_velocity = Vec3(0.0, 2.0, 0.0))]

    _ = step(bodies, room, 0.1).unwrap()
    near(bodies[0].position.x, 0.1)
    near(bodies[0].position.y, 0.2)
    near(bodies[0].position.z, -0.3)
    val rotated = bodies[0].orientation.rotate([1.0, 0.0, 0.0])

    near(rotated[0], 0.2.cos())
    near(rotated[2], -0.2.sin())
end flight

@test("equal masses exchange normal velocities")
equal_mass()
    var bodies = [sphere(Vec3(-0.5, 0.0, 0.0), Vec3(1.0, 0.0, 0.0), 0.5),
                  sphere(Vec3(0.5, 0.0, 0.0), Vec3(-1.0, 0.0, 0.0), 0.5)]

    _ = step(bodies, room, 0.01).unwrap()
    near(bodies[0].velocity.x, -1.0)
    near(bodies[1].velocity.x, 1.0)

@test("unequal masses follow the analytical elastic collision solution")
unequal_mass()
    var bodies = [sphere(Vec3(-0.5, 0.0, 0.0), Vec3(2.0, 0.0, 0.0), 0.5, 2.0),
                  sphere(Vec3(0.5, 0.0, 0.0), Vec3(-1.0, 0.0, 0.0), 0.5, 1.0)]

    _ = step(bodies, room, 0.01).unwrap()
    near(bodies[0].velocity.x, 0.0)
    near(bodies[1].velocity.x, 3.0)

@test("oblique impact conserves momentum and energy")
oblique()
    var bodies = [sphere(Vec3(-0.4, 0.0, 0.0), Vec3(2.0, 1.0, 0.5), 0.5, 2.0),
                  sphere(Vec3(0.4, 0.3, 0.0), Vec3(-1.0, -0.2, 0.0), 0.5, 3.0)]
    val momentum = bodies[0].velocity * 2.0 + bodies[1].velocity * 3.0
    val energy = bodies[0].kinetic_energy() + bodies[1].kinetic_energy()

    _ = step(bodies, room, 0.01).unwrap()
    val after = bodies[0].velocity * 2.0 + bodies[1].velocity * 3.0

    near(after.x, momentum.x)
    near(after.y, momentum.y)
    near(after.z, momentum.z)
    near(bodies[0].kinetic_energy() + bodies[1].kinetic_energy(), energy)
end oblique

@test("all six walls reflect the normal component only")
six_walls()
    for axis in 0..<3
        for sign in [-1.0, 1.0]
            var p = [0.0, 0.0, 0.0]
            var v = [0.2, 0.3, 0.4]

            p[axis] = sign * 4.59
            v[axis] = sign * 2.0
            var bodies = [sphere(Vec3(p[0], p[1], p[2]), Vec3(v[0], v[1], v[2]))]

            _ = step(bodies, room, 0.02).unwrap()
            val actual = bodies[0].velocity.array()

            for k in 0..<3
                near(actual[k], if k == axis then -v[k] else v[k])
end six_walls

@test("restitution controls the rebound")
inelastic()
    var bodies = [sphere(Vec3(4.59, 0.0, 0.0), Vec3(2.0, 0.0, 0.0))]

    _ = step(bodies, Enclosure(room.half_size, 0.25), 0.02).unwrap()
    near(bodies[0].velocity.x, -0.5)

@test("separating overlaps are corrected without a second bounce")
separating()
    var bodies = [sphere(Vec3(-0.3, 0.0, 0.0), Vec3(-1.0, 0.0, 0.0)),
                  sphere(Vec3(0.3, 0.0, 0.0), Vec3(1.0, 0.0, 0.0))]

    _ = step(bodies, room, 0.01).unwrap()
    near(bodies[0].velocity.x, -1.0)
    assert((bodies[1].position - bodies[0].position).length() >= 0.8 - 1e-9)

@test("coincident centres remain finite and separate")
coincident()
    var bodies = [sphere(zero, zero), sphere(zero, zero)]

    _ = step(bodies, room, 0.01).unwrap()
    assert(bodies[0].position.finite() && bodies[1].position.finite())
    near((bodies[1].position - bodies[0].position).length(), 0.8)

@test("adaptive stepping catches a fast head-on collision")
fast()
    var bodies = [sphere(Vec3(-2.0, 0.0, 0.0), Vec3(100.0, 0.0, 0.0), 0.1),
                  sphere(Vec3(2.0, 0.0, 0.0), Vec3(-100.0, 0.0, 0.0), 0.1)]

    val stats = step(bodies, room, 0.03).unwrap()

    assert(stats.substeps > 100)
    near(bodies[0].velocity.x, -100.0)
    near(bodies[1].velocity.x, 100.0)

@test("invalid inputs are rejected before any body changes")
invalid()
    var bodies = [sphere(zero, Vec3(1.0, 0.0, 0.0)), sphere(zero, zero, mass = -1.0)]

    assert(step(bodies, room, 0.01).is_err())
    near(bodies[0].position.x, 0.0)
    assert(step(bodies, room, -0.01).is_err())
    assert(step(bodies, Enclosure(zero, 1.0), 0.01).is_err())
    assert(step(bodies, Enclosure(room.half_size, 1.1), 0.01).is_err())

@test("zero time is a no-op")
zero_time()
    var bodies = [sphere(zero, Vec3(1.0, 0.0, 0.0))]

    assert_eq(step(bodies, room, 0.0).unwrap().substeps, 0)
    near(bodies[0].position.x, 0.0)

@test("inelastic sphere collision preserves momentum and loses the analytical energy")
inelastic_pair()
    var bodies = [sphere(Vec3(-0.4, 0.0, 0.0), Vec3(1.0, 0.0, 0.0)),
                  sphere(Vec3(0.4, 0.0, 0.0), Vec3(-1.0, 0.0, 0.0))]

    _ = step(bodies, Enclosure(room.half_size, 0.5), 0.01).unwrap()
    near(bodies[0].velocity.x, -0.5)
    near(bodies[1].velocity.x, 0.5)
    near(bodies[0].kinetic_energy() + bodies[1].kinetic_energy(), 0.25)

@test("empty storage takes no substeps")
empty()
    var bodies: [0]Body = []

    assert_eq(step(bodies, room, 0.01).unwrap().substeps, 0)

@test("invalid dimensions, nonfinite time and excessive speed are transactional errors")
bad_numbers()
    var bodies = [sphere(zero, Vec3(1.0e8, 0.0, 0.0))]

    assert(step(bodies, room, 0.1).is_err())
    near(bodies[0].position.x, 0.0)
    assert(step(bodies, room, 0.0 / 0.0).is_err())
    assert(step(bodies, room, 0.11).is_err())
    bodies[0] = sphere(zero, zero, radius = 5.0)
    assert(step(bodies, room, 0.01).is_err())
end bad_numbers

module sh.sysl.rheos

import sysl.math.{min, max}

// Normal points from A towards B. All points are shared world-space contact locations.
struct Manifold
    normal: Vec3
    depth: real
    points: [8]Vec3
    count: int

private empty_manifold() -> Manifold
    var points: [8]Vec3

    Manifold(Vec3(1.0, 0.0, 0.0), 0.0, points, 0)

private single(n: Vec3, depth: real, p: Vec3) -> Manifold
    var m = empty_manifold()

    m.normal = n
    m.depth = depth
    m.points[0] = p
    m.count = 1
    m
end single

private sphere_pair(a: Body, b: Body) -> Manifold
    val delta = b.position - a.position
    val distance = delta.length()
    val sum = a.radius + b.radius

    if distance > sum then return empty_manifold()
    val n = delta.unit()

    single(n, sum - distance, (a.position + n * a.radius + b.position - n * b.radius) * 0.5)
end sphere_pair

private sphere_box(s: Body, b: Body) -> Manifold
    val local = b.unrotate(s.position - b.position)
    val p = local.array()
    val h = b.half_size.array()
    var closest = [0.0, 0.0, 0.0]

    for k in 0..<3 do closest[k] = max(-h[k], min(h[k], p[k]))
    val delta = local - vec3(closest)
    val distance = delta.length()

    if distance > s.radius then return empty_manifold()
    var outward = delta.unit()
    var depth = s.radius - distance

    if distance < 1e-12
        var axis = 0

        for k in 1..<3
            if h[k] - p[k].abs() < h[axis] - p[axis].abs() then axis = k
        outward = axis_vector(axis) * (if p[axis] >= 0 then 1.0 else -1.0)
        depth = s.radius + h[axis] - p[axis].abs()
        closest[axis] = (if p[axis] >= 0 then h[axis] else -h[axis])
    end if

    val n = b.rotate(outward) * -1.0
    val point = (b.position + b.rotate(vec3(closest)) + s.position + n * s.radius) * 0.5

    single(n, depth, point)
end sphere_box

// Sutherland-Hodgman clipping against a side plane. A clipped quadrilateral has at most 8 vertices.
private clip(points: [16]Vec3, count: int, normal: Vec3, limit: real) -> ([16]Vec3, int)
    var result: [16]Vec3
    var size = 0

    if count == 0 then return (result, 0)
    var previous = points[count - 1]
    var before = previous.dot(normal) - limit

    for i in 0..<count
        val current = points[i]
        val after = current.dot(normal) - limit

        if (before <= 0) != (after <= 0)
            result[size] = previous + (current - previous) * (before / (before - after))
            size += 1
        if after <= 0
            result[size] = current
            size += 1
        previous = current
        before = after
    end for

    (result, size)
end clip

private face_contacts(a: Body, b: Body, n: Vec3, reference_axis: int, depth: real) -> Manifold
    val axes = [b.rotate(axis_vector(0)), b.rotate(axis_vector(1)), b.rotate(axis_vector(2))]
    var incident_axis = 0

    for k in 1..<3
        if axes[k].dot(n).abs() > axes[incident_axis].dot(n).abs() then incident_axis = k
    val bh = b.half_size.array()
    val incident_normal = axes[incident_axis] * (if axes[incident_axis].dot(n) > 0 then -1.0 else 1.0)
    val centre = b.position + incident_normal * bh[incident_axis]
    val u = axes[(incident_axis + 1) % 3] * bh[(incident_axis + 1) % 3]
    val v = axes[(incident_axis + 2) % 3] * bh[(incident_axis + 2) % 3]
    var points: [16]Vec3

    points[0] = centre + u + v
    points[1] = centre - u + v
    points[2] = centre - u - v
    points[3] = centre + u - v
    var count = 4
    val ah = a.half_size.array()

    for offset in 1..<3
        val axis = (reference_axis + offset) % 3
        val side = a.rotate(axis_vector(axis))

        for sign in [-1.0, 1.0]
            val normal = side * sign
            val (clipped, size) = clip(points, count, normal, a.position.dot(normal) + ah[axis])

            points = clipped
            count = size
    end for

    var m = empty_manifold()
    val face = a.position + n * ah[reference_axis]

    m.normal = n
    m.depth = depth
    for i in 0..<count
        val separation = (points[i] - face).dot(n)

        if separation <= 1e-8 && m.count < 8
            m.points[m.count] = points[i] - n * (separation * 0.5)
            m.count += 1
    end for

    m
end face_contacts

// The supporting edge parallel to axis. Zero projections choose a consistent side.
private edge(b: Body, axis: int, direction: Vec3) -> (Vec3, Vec3)
    val h = b.half_size.array()
    val d = b.unrotate(direction).array()
    var local = [0.0, 0.0, 0.0]

    for k in 0..<3
        if k != axis then local[k] = if d[k] >= 0 then h[k] else -h[k]
    val centre = b.position + b.rotate(vec3(local))
    val along = b.rotate(axis_vector(axis)) * h[axis]

    (centre - along, centre + along)
end edge

private edge_point(a0: Vec3, a1: Vec3, b0: Vec3, b1: Vec3) -> Vec3
    val u = a1 - a0
    val v = b1 - b0
    val w = a0 - b0
    val aa = u.dot(u)
    val bb = u.dot(v)
    val cc = v.dot(v)
    val dd = u.dot(w)
    val ee = v.dot(w)
    val denominator = aa * cc - bb * bb
    var s = if denominator > 1e-15 then max(0.0, min(1.0, (bb * ee - cc * dd) / denominator)) else 0.0
    val t = max(0.0, min(1.0, (bb * s + ee) / cc))

    s = max(0.0, min(1.0, (bb * t - dd) / aa))
    (a0 + u * s + b0 + v * t) * 0.5
end edge_point

private box_pair(a: Body, b: Body) -> Manifold
    val aa = [a.rotate(axis_vector(0)), a.rotate(axis_vector(1)), a.rotate(axis_vector(2))]
    val ba = [b.rotate(axis_vector(0)), b.rotate(axis_vector(1)), b.rotate(axis_vector(2))]
    val delta = b.position - a.position
    var normal = Vec3(1.0, 0.0, 0.0)
    var depth = 1.0e300
    var best = 0

    // Three face normals per box, and the nine edge cross products.
    for k in 0..<15
        val raw = if k < 3 then aa[k] elif k < 6 then ba[k - 3] else aa[(k - 6) / 3].cross(ba[(k - 6) % 3])
        val length = raw.length()

        if length > 1e-8
            val axis = raw * (1.0 / length)
            val overlap = a.extent(axis) + b.extent(axis) - delta.dot(axis).abs()

            if overlap < -1e-9 then return empty_manifold()
            // Prefer face contacts when an edge axis is essentially tied.
            if overlap < depth - 1e-8
                depth = max(0.0, overlap)
                normal = axis * (if delta.dot(axis) >= 0 then 1.0 else -1.0)
                best = k
    end for

    if best < 3 then return face_contacts(a, b, normal, best, depth)
    if best < 6
        var m = face_contacts(b, a, normal * -1.0, best - 3, depth)

        m.normal = normal
        return m
    val (a0, a1) = edge(a, (best - 6) / 3, normal)
    val (b0, b1) = edge(b, (best - 6) % 3, normal * -1.0)

    single(normal, depth, edge_point(a0, a1, b0, b1))
end box_pair

private primitive_contacts(a: Body, b: Body) -> Manifold
    if (b.position - a.position).length() > a.radius + b.radius then return empty_manifold()
    if a.shape == Shape.Sphere && b.shape == Shape.Sphere then return sphere_pair(a, b)
    if a.shape == Shape.Sphere then return sphere_box(a, b)
    if b.shape == Shape.Sphere
        var m = sphere_box(b, a)

        m.normal = m.normal * -1.0
        return m
    box_pair(a, b)
end primitive_contacts

// Checked queries expose bounded-iteration failures to callers and the simulation UI.
contacts_checked(a: Body, b: Body) -> Result[Manifold, string]
    if (b.position-a.position).length() > a.radius+b.radius then return Ok(empty_manifold())
    if a.shape == Shape.Ellipsoid || a.shape == Shape.Convex || b.shape == Shape.Ellipsoid || b.shape == Shape.Convex
        return convex_contacts(a, b)
    Ok(primitive_contacts(a, b))
end contacts_checked

contacts(a: Body, b: Body) -> Manifold = contacts_checked(a, b).expect("convex contact query")

private[rheos] wall_contacts(b: Body, half_size: Vec3, axis: int, sign: real) -> Manifold
    val n = axis_vector(axis) * sign
    val limit = half_size.array()[axis]
    val depth = b.position.dot(n) + b.extent(n) - limit

    if depth < 0 then return empty_manifold()
    if b.shape == Shape.Sphere || b.shape == Shape.Ellipsoid then return single(n, depth, b.support(n))
    if b.shape == Shape.Convex
        var m = empty_manifold()

        m.normal = n
        m.depth = depth
        b.mesh match
            Some(mesh) ->
                for v in mesh.vertices()
                    val p = b.position+b.rotate(v)

                    if p.dot(n) >= limit-1e-8 && m.count < 8
                        m.points[m.count] = p
                        m.count += 1
            None -> ()
        return m

    var m = empty_manifold()
    val h = b.half_size

    m.normal = n
    m.depth = depth
    for x in [-1.0, 1.0]
        for y in [-1.0, 1.0]
            for z in [-1.0, 1.0]
                val p = b.position + b.rotate(Vec3(h.x * x, h.y * y, h.z * z))

                if p.dot(n) >= limit - 1e-8
                    m.points[m.count] = p
                    m.count += 1
    end for

    m
end wall_contacts
